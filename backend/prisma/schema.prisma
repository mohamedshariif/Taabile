// Taabile data model v0.1
// Conventions: every tenant table has companyId (required for row-level security).
// Stock movements, journal entries, journal lines and audit logs are append-only (enforced in constraints.sql).
// Actor columns (createdById, approvedById, ...) are plain UUIDs set by the server from the session.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime (the API): restricted user. Migrations run through scripts/prisma-owner.mjs,
  // which swaps in MIGRATE_DATABASE_URL (the owner) so tables can be created.
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  STORE
  WAREHOUSE
}

enum SaleType {
  RETAIL
  WHOLESALE
}

enum DocStatus {
  POSTED
  VOIDED
}

enum MovementType {
  OPENING
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  SALE_RELEASE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  DAMAGE
  //REVERSAL
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}
/* enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  DISCREPANCY
  CLOSED
  CANCELLED
} */

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum FulfillmentStatus {
  PENDING
  PARTIAL
  COMPLETE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum FinancialAccountType {
  CASH
  BANK
}

enum FundsTransferType {
  DEPOSIT
  HANDOVER
  WITHDRAWAL
  TRANSFER
}

enum ConfirmStatus {
  PENDING
  CONFIRMED
}

enum PriceListKind {
  WHOLESALE
  RETAIL
}

enum CostType {
  FREIGHT
  HANDLING
  CONTAINER
  OTHER
}

enum ExpensePayStatus {
  PAID
  UNPAID
}

enum EmployeeLedgerType {
  SALARY_EARNED
  SALARY_PAID
  ADVANCE
  WITHDRAWAL
  REIMBURSEMENT
  ADJUSTMENT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PeriodStatus {
  OPEN
  LOCKED
}

// ───────────────────────── Platform and access ─────────────────────────

// Software provider staff. Separate from company users: they belong to no company.
model PlatformAdmin {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@map("platform_admins")
}

model Company {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  legalName             String?
  country               String
  currency              String                @default("USD") @db.Char(3)
  timezone              String                @default("Africa/Juba")
  fiscalYearStartMonth  Int                   @default(1)
  taxRate               Decimal               @default(0) @db.Decimal(7, 4)
  status                RecordStatus          @default(ACTIVE)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  memberships           Membership[]
  membershipLocations   MembershipLocation[]
  invitations           Invitation[]
  locations             Location[]
  auditLogs             AuditLog[]
  documentSequences     DocumentSequence[]
  idempotencyKeys       IdempotencyKey[]
  categories            Category[]
  products              Product[]
  productUnits          ProductUnit[]
  priceLists            PriceList[]
  productPrices         ProductPrice[]
  customers             Customer[]
  suppliers             Supplier[]
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  transfers             Transfer[]
  transferLines         TransferLine[]
  stockCounts           StockCount[]
  stockCountLines       StockCountLine[]
  purchaseReceipts      PurchaseReceipt[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  purchaseCosts         PurchaseCost[]
  sales                 Sale[]
  saleLines             SaleLine[]
  saleLineAllocations   SaleLineAllocation[]
  saleReleases          SaleRelease[]
  saleReleaseLines      SaleReleaseLine[]
  saleReturns           SaleReturn[]
  saleReturnLines       SaleReturnLine[]
  financialAccounts     FinancialAccount[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  fundsTransfers        FundsTransfer[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  employees             Employee[]
  salaryAgreements      SalaryAgreement[]
  employeeLedgerEntries EmployeeLedgerEntry[]
  accounts              Account[]
  accountingPeriods     AccountingPeriod[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]

  @@map("companies")
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  name               String
  passwordHash       String?
  mustChangePassword Boolean        @default(false)
  status             RecordStatus   @default(ACTIVE)
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?      @db.Timestamptz(3)
  lastLoginAt        DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  memberships        Membership[]
  refreshTokens      RefreshToken[]
  employee           Employee?

  @@map("users")
}

model Membership {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  company             Company              @relation(fields: [companyId], references: [id])
  userId              String               @db.Uuid
  user                User                 @relation(fields: [userId], references: [id])
  role                Role
  status              RecordStatus         @default(ACTIVE)
  extraPermissions    String[]             @default([])
  revokedPermissions  String[]             @default([])
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  membershipLocations MembershipLocation[]

  @@unique([companyId, userId])
  @@map("memberships")
}

model MembershipLocation {
  membershipId String     @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id])
  locationId   String     @db.Uuid
  location     Location   @relation(fields: [locationId], references: [id])
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id])

  @@id([membershipId, locationId])
  @@map("membership_locations")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        Role
  locationIds String[]  @default([])
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  invitedById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([companyId, email])
  @@map("invitations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  activeCompanyId String   @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("refresh_tokens")
}

model Location {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  company             Company              @relation(fields: [companyId], references: [id])
  name                String
  code                String
  type                LocationType
  status              RecordStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  membershipLocations MembershipLocation[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  transfersOut        Transfer[]           @relation("TransferFrom")
  transfersIn         Transfer[]           @relation("TransferTo")
  stockCounts         StockCount[]
  purchaseReceipts    PurchaseReceipt[]
  sales               Sale[]
  saleLineAllocations SaleLineAllocation[]
  saleReleases        SaleRelease[]
  saleReturnLines     SaleReturnLine[]
  financialAccounts   FinancialAccount[]
  expenses            Expense[]
  employees           Employee[]
  journalLines        JournalLine[]

  @@unique([companyId, code])
  @@map("locations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @db.Uuid
  company    Company? @relation(fields: [companyId], references: [id])
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model DocumentSequence {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @db.Uuid
  company    Company @relation(fields: [companyId], references: [id])
  docType    String
  scopeKey   String
  prefix     String
  nextNumber Int     @default(1)

  @@unique([companyId, docType, scopeKey])
  @@map("document_sequences")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  userId         String   @db.Uuid
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([companyId, key])
  @@map("idempotency_keys")
}

// ───────────────────────── Catalog and parties ─────────────────────────

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  products  Product[]

  @@unique([companyId, name])
  @@map("categories")
}

model Product {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  company              Company               @relation(fields: [companyId], references: [id])
  sku                  String
  name                 String
  categoryId           String?               @db.Uuid
  category             Category?             @relation(fields: [categoryId], references: [id])
  baseUnit             String
  barcode              String?
  imageUrl             String?
  status               RecordStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  productUnits         ProductUnit[]
  productPrices        ProductPrice[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  transferLines        TransferLine[]
  stockCountLines      StockCountLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  saleLines            SaleLine[]

  @@unique([companyId, sku])
  @@index([companyId, barcode])
  @@map("products")
}

model ProductUnit {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  company              Company               @relation(fields: [companyId], references: [id])
  productId            String                @db.Uuid
  product              Product               @relation(fields: [productId], references: [id])
  name                 String
  factorToBase         Decimal               @default(1) @db.Decimal(18, 6)
  isPurchaseUnit       Boolean               @default(false)
  isSaleUnit           Boolean               @default(true)
  productPrices        ProductPrice[]
  purchaseReceiptLines PurchaseReceiptLine[]
  saleLines            SaleLine[]

  @@unique([productId, name])
  @@map("product_units")
}

model PriceList {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id])
  name          String
  kind          PriceListKind
  isDefault     Boolean        @default(false)
  productPrices ProductPrice[]
  customers     Customer[]

  @@unique([companyId, name])
  @@map("price_lists")
}

model ProductPrice {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id])
  priceListId   String      @db.Uuid
  priceList     PriceList   @relation(fields: [priceListId], references: [id])
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id])
  productUnitId String      @db.Uuid
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])
  price         Decimal     @db.Decimal(19, 4)

  @@unique([priceListId, productUnitId])
  @@map("product_prices")
}

model Customer {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id])
  code             String
  name             String
  phone            String?
  address          String?
  priceListId      String?       @db.Uuid
  priceList        PriceList?    @relation(fields: [priceListId], references: [id])
  creditLimit      Decimal?      @db.Decimal(19, 4)
  paymentTermsDays Int           @default(0)
  status           RecordStatus  @default(ACTIVE)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  sales            Sale[]
  payments         Payment[]
  journalLines     JournalLine[]

  @@unique([companyId, code])
  @@map("customers")
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id])
  code             String
  name             String
  phone            String?
  paymentTermsDays Int               @default(0)
  status           RecordStatus      @default(ACTIVE)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  purchaseReceipts PurchaseReceipt[]
  payments         Payment[]
  expenses         Expense[]
  journalLines     JournalLine[]

  @@unique([companyId, code])
  @@map("suppliers")
}

// ───────────────────────── Inventory ─────────────────────────

model StockBalance {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  onHand     Decimal  @default(0) @db.Decimal(18, 4)
  committed  Decimal  @default(0) @db.Decimal(18, 4)
  avgCost    Decimal  @default(0) @db.Decimal(19, 6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([locationId, productId])
  @@index([companyId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @db.Uuid
  company      Company        @relation(fields: [companyId], references: [id])
  locationId   String         @db.Uuid
  location     Location       @relation(fields: [locationId], references: [id])
  productId    String         @db.Uuid
  product      Product        @relation(fields: [productId], references: [id])
  type         MovementType
  quantity     Decimal        @db.Decimal(18, 4)
  unitCost     Decimal        @default(0) @db.Decimal(19, 6)
  totalCost    Decimal        @default(0) @db.Decimal(19, 4)
  refType      String
  refId        String?        @db.Uuid
  reason       String?
  occurredAt   DateTime       @default(now()) @db.Timestamptz(3)
  createdById  String         @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  reversalOfId String?        @unique @db.Uuid
  reversalOf   StockMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockMovement? @relation("MovementReversal")

  @@index([companyId, locationId, productId, occurredAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model Transfer {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  company        Company        @relation(fields: [companyId], references: [id])
  number         String
  fromLocationId String         @db.Uuid
  fromLocation   Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String         @db.Uuid
  toLocation     Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  status         TransferStatus @default(REQUESTED)
  requestedById  String         @db.Uuid
  approvedById   String?        @db.Uuid
  dispatchedById String?        @db.Uuid
  receivedById   String?        @db.Uuid
  requestedAt    DateTime       @default(now()) @db.Timestamptz(3)
  dispatchedAt   DateTime?      @db.Timestamptz(3)
  receivedAt     DateTime?      @db.Timestamptz(3)
  note           String?
  transferLines  TransferLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("transfers")
}

model TransferLine {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  company         Company  @relation(fields: [companyId], references: [id])
  transferId      String   @db.Uuid
  transfer        Transfer @relation(fields: [transferId], references: [id])
  productId       String   @db.Uuid
  product         Product  @relation(fields: [productId], references: [id])
  qtyRequested    Decimal  @db.Decimal(18, 4)
  qtyDispatched   Decimal  @default(0) @db.Decimal(18, 4)
  qtyReceived     Decimal  @default(0) @db.Decimal(18, 4)
  discrepancyNote String?

  @@unique([transferId, productId])
  @@map("transfer_lines")
}

model StockCount {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id])
  number          String
  locationId      String           @db.Uuid
  location        Location         @relation(fields: [locationId], references: [id])
  status          CountStatus      @default(OPEN)
  countedAt       DateTime         @db.Timestamptz(3)
  countedById     String           @db.Uuid
  approvedById    String?          @db.Uuid
  approvedAt      DateTime?        @db.Timestamptz(3)
  note            String?
  stockCountLines StockCountLine[]

  @@unique([companyId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id])
  countId     String     @db.Uuid
  count       StockCount @relation(fields: [countId], references: [id])
  productId   String     @db.Uuid
  product     Product    @relation(fields: [productId], references: [id])
  expectedQty Decimal    @db.Decimal(18, 4)
  countedQty  Decimal    @db.Decimal(18, 4)
  difference  Decimal    @db.Decimal(18, 4)
  reason      String?

  @@unique([countId, productId])
  @@map("stock_count_lines")
}

// ───────────────────────── Purchasing ─────────────────────────

model PurchaseReceipt {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  company              Company               @relation(fields: [companyId], references: [id])
  number               String
  supplierId           String                @db.Uuid
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  locationId           String                @db.Uuid
  location             Location              @relation(fields: [locationId], references: [id])
  containerRef         String?
  supplierInvoiceRef   String?
  invoiceDate          DateTime?             @db.Date
  dueDate              DateTime?             @db.Date
  receivedAt           DateTime              @db.Timestamptz(3)
  status               DocStatus             @default(POSTED)
  goodsTotal           Decimal               @db.Decimal(19, 4)
  costTotal            Decimal               @default(0) @db.Decimal(19, 4)
  total                Decimal               @db.Decimal(19, 4)
  paidTotal            Decimal               @default(0) @db.Decimal(19, 4)
  createdById          String                @db.Uuid
  note                 String?
  purchaseReceiptLines PurchaseReceiptLine[]
  purchaseCosts        PurchaseCost[]
  paymentAllocations   PaymentAllocation[]

  @@unique([companyId, number])
  @@unique([companyId, supplierId, supplierInvoiceRef])
  @@index([companyId, supplierId])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  company            Company         @relation(fields: [companyId], references: [id])
  receiptId          String          @db.Uuid
  receipt            PurchaseReceipt @relation(fields: [receiptId], references: [id])
  productId          String          @db.Uuid
  product            Product         @relation(fields: [productId], references: [id])
  productUnitId      String          @db.Uuid
  productUnit        ProductUnit     @relation(fields: [productUnitId], references: [id])
  qtyExpected        Decimal         @db.Decimal(18, 4)
  qtyReceived        Decimal         @db.Decimal(18, 4)
  qtyDamaged         Decimal         @default(0) @db.Decimal(18, 4)
  qtyReceivedBase    Decimal         @db.Decimal(18, 4)
  unitCost           Decimal         @db.Decimal(19, 4)
  landedUnitCostBase Decimal         @db.Decimal(19, 6)
  lineTotal          Decimal         @db.Decimal(19, 4)

  @@map("purchase_receipt_lines")
}

model PurchaseCost {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @db.Uuid
  company   Company         @relation(fields: [companyId], references: [id])
  receiptId String          @db.Uuid
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id])
  type      CostType
  amount    Decimal         @db.Decimal(19, 4)
  note      String?

  @@map("purchase_costs")
}

// ───────────────────────── Sales ─────────────────────────

model Sale {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  company            Company             @relation(fields: [companyId], references: [id])
  number             String
  locationId         String              @db.Uuid
  location           Location            @relation(fields: [locationId], references: [id])
  customerId         String?             @db.Uuid
  customer           Customer?           @relation(fields: [customerId], references: [id])
  status             DocStatus           @default(POSTED)
  type      SaleType       @default(RETAIL)
  paymentStatus      PaymentStatus       @default(UNPAID)
  fulfillmentStatus  FulfillmentStatus   @default(PENDING)
  subtotal           Decimal             @db.Decimal(19, 4)
  discountTotal      Decimal             @default(0) @db.Decimal(19, 4)
  taxTotal           Decimal             @default(0) @db.Decimal(19, 4)
  total              Decimal             @db.Decimal(19, 4)
  paidTotal          Decimal             @default(0) @db.Decimal(19, 4)
  soldAt             DateTime            @default(now()) @db.Timestamptz(3)
  dueDate            DateTime?           @db.Date
  createdById        String              @db.Uuid
  voidedAt           DateTime?           @db.Timestamptz(3)
  voidedById         String?             @db.Uuid
  voidReason         String?
  note               String?
  saleLines          SaleLine[]
  saleReleases       SaleRelease[]
  saleReturns        SaleReturn[]
  paymentAllocations PaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, locationId, soldAt])
  @@index([companyId, customerId])
  @@index([companyId, createdById, soldAt])
  @@map("sales")
}

model SaleLine {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  company             Company              @relation(fields: [companyId], references: [id])
  saleId              String               @db.Uuid
  sale                Sale                 @relation(fields: [saleId], references: [id])
  productId           String               @db.Uuid
  product             Product              @relation(fields: [productId], references: [id])
  productUnitId       String               @db.Uuid
  productUnit         ProductUnit          @relation(fields: [productUnitId], references: [id])
  quantity            Decimal              @db.Decimal(18, 4)
  quantityBase        Decimal              @db.Decimal(18, 4)
  unitPrice           Decimal              @db.Decimal(19, 4)
  discount            Decimal              @default(0) @db.Decimal(19, 4)
  taxAmount           Decimal              @default(0) @db.Decimal(19, 4)
  lineTotal           Decimal              @db.Decimal(19, 4)
  saleLineAllocations SaleLineAllocation[]
  saleReturnLines     SaleReturnLine[]

  @@index([saleId])
  @@map("sale_lines")
}

model SaleLineAllocation {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id])
  saleLineId       String            @db.Uuid
  saleLine         SaleLine          @relation(fields: [saleLineId], references: [id])
  supplyLocationId String            @db.Uuid
  supplyLocation   Location          @relation(fields: [supplyLocationId], references: [id])
  qtyBase          Decimal           @db.Decimal(18, 4)
  qtyReleased      Decimal           @default(0) @db.Decimal(18, 4)
  saleReleaseLines SaleReleaseLine[]

  @@index([supplyLocationId])
  @@map("sale_line_allocations")
}

model SaleRelease {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id])
  saleId           String            @db.Uuid
  sale             Sale              @relation(fields: [saleId], references: [id])
  locationId       String            @db.Uuid
  location         Location          @relation(fields: [locationId], references: [id])
  releasedById     String            @db.Uuid
  releasedAt       DateTime          @default(now()) @db.Timestamptz(3)
  note             String?
  saleReleaseLines SaleReleaseLine[]

  @@map("sale_releases")
}

model SaleReleaseLine {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  company      Company            @relation(fields: [companyId], references: [id])
  releaseId    String             @db.Uuid
  release      SaleRelease        @relation(fields: [releaseId], references: [id])
  allocationId String             @db.Uuid
  allocation   SaleLineAllocation @relation(fields: [allocationId], references: [id])
  qtyBase      Decimal            @db.Decimal(18, 4)

  @@map("sale_release_lines")
}

model SaleReturn {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id])
  number          String
  saleId          String           @db.Uuid
  sale            Sale             @relation(fields: [saleId], references: [id])
  reason          String
  subtotal        Decimal          @db.Decimal(19, 4)
  taxTotal        Decimal          @default(0) @db.Decimal(19, 4)
  total           Decimal          @db.Decimal(19, 4)
  refundAmount    Decimal          @default(0) @db.Decimal(19, 4)
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  saleReturnLines SaleReturnLine[]

  @@unique([companyId, number])
  @@map("sale_returns")
}

model SaleReturnLine {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id])
  returnId     String     @db.Uuid
  saleReturn   SaleReturn @relation(fields: [returnId], references: [id])
  saleLineId   String     @db.Uuid
  saleLine     SaleLine   @relation(fields: [saleLineId], references: [id])
  quantityBase Decimal    @db.Decimal(18, 4)
  amount       Decimal    @db.Decimal(19, 4)
  restock      Boolean    @default(true)
  locationId   String?    @db.Uuid
  location     Location?  @relation(fields: [locationId], references: [id])

  @@map("sale_return_lines")
}

// ───────────────────────── Cash, payments, expenses ─────────────────────────

model FinancialAccount {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @db.Uuid
  company               Company               @relation(fields: [companyId], references: [id])
  name                  String
  type                  FinancialAccountType
  locationId            String?               @db.Uuid
  location              Location?             @relation(fields: [locationId], references: [id])
  ledgerAccountId       String                @db.Uuid
  ledgerAccount         Account               @relation(fields: [ledgerAccountId], references: [id])
  status                RecordStatus          @default(ACTIVE)
  payments              Payment[]
  fundsOut              FundsTransfer[]       @relation("FundsFrom")
  fundsIn               FundsTransfer[]       @relation("FundsTo")
  expenses              Expense[]
  employeeLedgerEntries EmployeeLedgerEntry[]

  @@unique([companyId, name])
  @@map("financial_accounts")
}

model Payment {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  company            Company             @relation(fields: [companyId], references: [id])
  number             String
  partyType          PartyType
  customerId         String?             @db.Uuid
  customer           Customer?           @relation(fields: [customerId], references: [id])
  supplierId         String?             @db.Uuid
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  financialAccountId String              @db.Uuid
  financialAccount   FinancialAccount    @relation(fields: [financialAccountId], references: [id])
  method             PaymentMethod
  amount             Decimal             @db.Decimal(19, 4)
  paidAt             DateTime            @db.Timestamptz(3)
  reference          String?
  status             DocStatus           @default(POSTED)
  createdById        String              @db.Uuid
  note               String?
  paymentAllocations PaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
  @@map("payments")
}

model PaymentAllocation {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  company           Company          @relation(fields: [companyId], references: [id])
  paymentId         String           @db.Uuid
  payment           Payment          @relation(fields: [paymentId], references: [id])
  saleId            String?          @db.Uuid
  sale              Sale?            @relation(fields: [saleId], references: [id])
  purchaseReceiptId String?          @db.Uuid
  purchaseReceipt   PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id])
  amount            Decimal          @db.Decimal(19, 4)
  createdById       String           @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
  @@map("payment_allocations")
}

model FundsTransfer {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id])
  number           String
  type             FundsTransferType
  fromAccountId    String            @db.Uuid
  fromAccount      FinancialAccount  @relation("FundsFrom", fields: [fromAccountId], references: [id])
  toAccountId      String            @db.Uuid
  toAccount        FinancialAccount  @relation("FundsTo", fields: [toAccountId], references: [id])
  amount           Decimal           @db.Decimal(19, 4)
  expectedAmount   Decimal?          @db.Decimal(19, 4)
  countedAmount    Decimal?          @db.Decimal(19, 4)
  differenceAmount Decimal           @default(0) @db.Decimal(19, 4)
  feeAmount        Decimal           @default(0) @db.Decimal(19, 4)
  differenceNote   String?
  status           ConfirmStatus     @default(PENDING)
  occurredAt       DateTime          @db.Timestamptz(3)
  createdById      String            @db.Uuid
  confirmedById    String?           @db.Uuid
  confirmedAt      DateTime?         @db.Timestamptz(3)

  @@unique([companyId, number])
  @@map("funds_transfers")
}

model ExpenseCategory {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  name            String
  ledgerAccountId String    @db.Uuid
  ledgerAccount   Account   @relation(fields: [ledgerAccountId], references: [id])
  expenses        Expense[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

model Expense {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  company            Company           @relation(fields: [companyId], references: [id])
  number             String
  locationId         String?           @db.Uuid
  location           Location?         @relation(fields: [locationId], references: [id])
  categoryId         String            @db.Uuid
  category           ExpenseCategory   @relation(fields: [categoryId], references: [id])
  amount             Decimal           @db.Decimal(19, 4)
  incurredAt         DateTime          @db.Timestamptz(3)
  description        String
  payStatus          ExpensePayStatus  @default(PAID)
  financialAccountId String?           @db.Uuid
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  supplierId         String?           @db.Uuid
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  paidByEmployeeId   String?           @db.Uuid
  paidByEmployee     Employee?         @relation(fields: [paidByEmployeeId], references: [id])
  status             DocStatus         @default(POSTED)
  evidenceUrl        String?
  createdById        String            @db.Uuid
  approvedById       String?           @db.Uuid
  approvedAt         DateTime?         @db.Timestamptz(3)

  @@unique([companyId, number])
  @@index([companyId, locationId, incurredAt])
  @@map("expenses")
}

// ───────────────────────── Payroll and employee funds ─────────────────────────

model Employee {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @db.Uuid
  company               Company               @relation(fields: [companyId], references: [id])
  userId                String?               @unique @db.Uuid
  user                  User?                 @relation(fields: [userId], references: [id])
  name                  String
  phone                 String?
  position              String?
  locationId            String?               @db.Uuid
  location              Location?             @relation(fields: [locationId], references: [id])
  status                RecordStatus          @default(ACTIVE)
  startedOn             DateTime?             @db.Date
  expenses              Expense[]
  salaryAgreements      SalaryAgreement[]
  employeeLedgerEntries EmployeeLedgerEntry[]
  journalLines          JournalLine[]

  @@map("employees")
}

model SalaryAgreement {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id])
  employeeId    String    @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id])
  monthlyAmount Decimal   @db.Decimal(19, 4)
  effectiveFrom DateTime  @db.Date
  endedOn       DateTime? @db.Date

  @@map("salary_agreements")
}

model EmployeeLedgerEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  company            Company            @relation(fields: [companyId], references: [id])
  employeeId         String             @db.Uuid
  employee           Employee           @relation(fields: [employeeId], references: [id])
  type               EmployeeLedgerType
  amount             Decimal            @db.Decimal(19, 4)
  period             String?
  financialAccountId String?            @db.Uuid
  financialAccount   FinancialAccount?  @relation(fields: [financialAccountId], references: [id])
  occurredAt         DateTime           @db.Timestamptz(3)
  note               String?
  createdById        String             @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  @@index([companyId, employeeId, occurredAt])
  @@map("employee_ledger_entries")
}

// ───────────────────────── Accounting ─────────────────────────

model Account {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  company           Company            @relation(fields: [companyId], references: [id])
  code              String
  name              String
  type              AccountType
  parentId          String?            @db.Uuid
  parent            Account?           @relation("AccountParent", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountParent")
  systemKey         String?
  isPostable        Boolean            @default(true)
  status            RecordStatus       @default(ACTIVE)
  financialAccounts FinancialAccount[]
  expenseCategories ExpenseCategory[]
  journalLines      JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@map("accounts")
}

model AccountingPeriod {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  company        Company        @relation(fields: [companyId], references: [id])
  year           Int
  month          Int
  status         PeriodStatus   @default(OPEN)
  lockedAt       DateTime?      @db.Timestamptz(3)
  lockedById     String?        @db.Uuid
  journalEntries JournalEntry[]

  @@unique([companyId, year, month])
  @@map("accounting_periods")
}

model JournalEntry {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  company      Company          @relation(fields: [companyId], references: [id])
  number       String
  entryDate    DateTime         @db.Date
  periodId     String           @db.Uuid
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  description  String
  sourceType   String
  sourceId     String?          @db.Uuid
  postingKey   String
  isManual     Boolean          @default(false)
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  reversalOfId String?          @unique @db.Uuid
  reversalOf   JournalEntry?    @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry?    @relation("EntryReversal")
  journalLines JournalLine[]

  @@unique([companyId, number])
  @@unique([companyId, postingKey])
  @@index([companyId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  company    Company      @relation(fields: [companyId], references: [id])
  entryId    String       @db.Uuid
  entry      JournalEntry @relation(fields: [entryId], references: [id])
  accountId  String       @db.Uuid
  account    Account      @relation(fields: [accountId], references: [id])
  debit      Decimal      @default(0) @db.Decimal(19, 4)
  credit     Decimal      @default(0) @db.Decimal(19, 4)
  locationId String?      @db.Uuid
  location   Location?    @relation(fields: [locationId], references: [id])
  customerId String?      @db.Uuid
  customer   Customer?    @relation(fields: [customerId], references: [id])
  supplierId String?      @db.Uuid
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  employeeId String?      @db.Uuid
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  memo       String?

  @@index([companyId, accountId])
  @@index([entryId])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
  @@map("journal_lines")
}
