# Owner connection: used by migrations and `npm run db:setup` only.
MIGRATE_DATABASE_URL=postgresql://taabile:taabile_dev@localhost:5432/taabile
# Runtime connection: used by the API. Subject to row-level security and ledger protections.
DATABASE_URL=postgresql://taabile_app:taabile_app_dev@localhost:5432/taabile
PORT=4000
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# The frontend address (allowed by CORS)
APP_BASE_URL=http://localhost:5173
